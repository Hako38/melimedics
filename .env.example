# development | staging | production
SITE_ENV=development

# Canonical origin. Keep production value for canonical URLs on preview builds.
SITE_URL=https://melimedics.de

# Tracking remains intentionally disabled until consent and legal approval exist.

# Hair consultation infrastructure. Disabled means that no submission is stored.
STORAGE_PROVIDER=disabled
CONSULTATION_REPOSITORY=disabled
CONSULTATION_DATA_DIR=

# Notification remains optional. A missing mail provider must never expose photos.
MAIL_PROVIDER=disabled
MAIL_FROM=
CONSULTATION_RECIPIENT=

# Legal text versions are server-side audit identifiers, not legal copy.
CONSENT_CONTACT_VERSION=needs_review
CONSENT_PHOTO_VERSION=needs_review

# Production must keep this true until an approved scanner adapter is configured.
MALWARE_SCAN_PROVIDER=disabled
REQUIRE_MALWARE_SCAN=true

# Set only after legal approval. Empty/zero disables retention-based deletion.
RETENTION_DAYS=

# Request and abuse controls.
CONSULTATION_MAX_REQUEST_BYTES=28311552
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SALT=

# Phase 3B public assistant. Disabled is the production-safe default.
AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=300
AI_TIMEOUT_MS=12000

# Sensitive consultation data stays local unless this receives separate approval.
AI_CONSULTATION_ENHANCER_ENABLED=false

# Assistant abuse controls. Use a production secret for the hashing salt.
AI_RATE_LIMIT_MAX=12
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_SALT=

# Phase 3C automation and communication. Both switches must be true before
# an approved persistent scheduler and communication provider may run.
COMMUNICATION_ENABLED=false
COMMUNICATION_PROVIDER=
MELIMEDICS_NOTIFICATION_RECIPIENT=
AUTOMATION_ENABLED=false
AUTOMATION_MAX_RETRIES=
REVIEW_URL=
